TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN # Generated using @BotFather on Telegram
ALLOW_UNRESTRICTED_TELEGRAM_ACCESS=false

# Model information
MODEL_NAME=Emery
MODEL_ID=qwen3.6:35b-a3b
FAST_MODEL_ID=lfm2.5:8b
VISION_MODEL_ID=minicpm4.5:8b
EMBEDDING_MODEL_ID=nomic-embed-text
MAIN_MODEL_URL=http://127.0.0.1:8081/v1/chat/completions
MAIN_MODEL_VISION=true
MAIN_MODEL_IMAGE_FORMAT=openai
MAIN_MODEL_REASONING_EFFORT=medium
MAIN_MODEL_MAX_TOKENS=32768
MAIN_MODEL_REASONING_BUDGET=16384
MAIN_MODEL_REASONING_BUDGET_MESSAGE=The reasoning budget is exhausted. Stop thinking and provide the final answer now.
FAST_MODEL_URL=http://127.0.0.1:8082/v1/chat/completions
ENABLE_LIVE_PROGRESS=true
ENABLE_LIVE_STEERING=true
LIVE_STEERING_MAX_PENDING=4
LIVE_PROGRESS_MIN_DELAY_SECONDS=1.2
LIVE_PROGRESS_EDIT_INTERVAL_SECONDS=1.5
LIVE_PROGRESS_HEARTBEAT_INTERVAL_SECONDS=15.0
LIVE_PROGRESS_MAX_CHARS=240
VISION_OLLAMA_URL=http://localhost:11434/api/chat
EMBEDDING_OLLAMA_URL=http://localhost:11434/api/embed
OLLAMA_VISION_NUM_CTX=65536
MAX_RESEARCH_IMAGES_PER_TURN=1
PREFERRED_RESEARCH_IMAGES_PER_TURN=1
MAX_MODEL_IMAGE_ATTACHMENTS_PER_LOOP=1
MAX_MODEL_IMAGE_ATTACHMENTS_PER_TURN=2
RESEARCH_IMAGE_CACHE_TTL_SECONDS=3600
RESEARCH_IMAGE_MAX_BYTES=8000000
RESEARCH_IMAGE_MAX_DIMENSION=1600
OPEN_WEBUI_KEY=YOUR_OPEN_WEBUI_KEY
STT_URL=http://localhost:3000/api/v1/audio/transcriptions
TTS_URL=http://localhost:8880/v1/audio/speech
TTS_VOICE=af_heart
DOCLING_URL=
DOCLING_BEARER_TOKEN=

# Feature flags
ENABLE_CALENDAR=true
ENABLE_WEATHER=true
ENABLE_NEWS=true
ENABLE_NASA=true
ENABLE_SEERR=true
ENABLE_HISTORY=true
ENABLE_VOICE=true
ENABLE_IMAGEGEN=true
ENABLE_SEARCH=true
ENABLE_WEB_SCRAPING=true
ENABLE_DOCLING=true
ENABLE_YOUTUBE_TRANSCRIPT=true
ENABLE_FINANCE=false
ENABLE_SYSTEM_STATS=true
# Command execution is opt-in. Destructive commands require a Telegram approval;
# keep this disabled unless you want host access.
ENABLE_COMMAND_EXECUTION=false
COMMAND_EXECUTION_CWD=.
COMMAND_EXECUTION_TIMEOUT_SECONDS=30
COMMAND_EXECUTION_MAX_TIMEOUT_SECONDS=120
COMMAND_EXECUTION_MAX_OUTPUT_CHARS=12000
COMMAND_EXECUTION_ALLOW_DANGEROUS=false
COMMAND_EXECUTION_APPROVAL_TIMEOUT_SECONDS=300
COMMAND_EXECUTION_SHELL=/bin/sh
# Select local, docker, or ssh. Docker/SSH require their own configured target.
COMMAND_EXECUTION_BACKEND=local
COMMAND_EXECUTION_DOCKER_BINARY=docker
COMMAND_EXECUTION_DOCKER_IMAGE=python:3.11-slim
COMMAND_EXECUTION_SSH_BINARY=ssh
COMMAND_EXECUTION_SSH_HOST=
COMMAND_EXECUTION_SSH_USER=
COMMAND_EXECUTION_SSH_PORT=
COMMAND_EXECUTION_SSH_KEY=
# Browser control is also opt-in. It connects to an existing Chromium CDP
# endpoint, or can launch a separate profile when BROWSER_AUTO_LAUNCH=true.
ENABLE_BROWSER=false
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_AUTO_LAUNCH=true
BROWSER_HEADLESS=true
BROWSER_CHROMIUM_PATH=
BROWSER_USER_DATA_DIR=data/browser-profile
BROWSER_TIMEOUT_SECONDS=10
BROWSER_REQUIRE_ACTION_APPROVAL=true
BROWSER_ACTION_APPROVAL_TIMEOUT_SECONDS=300
ENABLE_NEST=false
ENABLE_REOLINK=false
ENABLE_SCHEDULER=true
ENABLE_HEARTBEAT=false
ENABLE_MEMORY=true
# Optional: use Telegram Rich Messages instead of the broadly compatible HTML path.
# Leave disabled unless all target Telegram clients support Rich Messages.
ENABLE_TELEGRAM_RICH_MESSAGES=false
ENABLE_ROUTINE_CACHE_WARMUP=true
ENABLE_MEALIE=false

# Mealie recipe import
MEALIE_URL=
MEALIE_API_KEY=

# Secrets / API keys
NASA_API_KEY=YOUR_NASA_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
FRED_API_KEY=YOUR_FRED_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
OVERSEER_URL=http://localhost:5055/api/v1
OVERSEER_KEY=YOUR_OVERSEER_KEY
OVERSEER_USER_ID=1
SEARXNG_URL=http://localhost:8080/search
ALLOW_PRIVATE_WEB_FETCH=false
NOAA_EMAIL=example@example.com
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_SSL_VERIFY=true
REOLINK_HOST=YOUR_REOLINK_NVR_IP
REOLINK_USER=YOUR_REOLINK_USER
REOLINK_PASSWORD=YOUR_REOLINK_PASSWORD
GIPHY_API_KEY=YOUR_GIPHY_API_KEY
TENOR_API_KEY=YOUR_TENOR_API_KEY

# File paths
MEMORY_STORE_PATH=data/memory/memory_store.json
CAMERA_LOG_FILE_PATH=data/logs/camera_log.md
GOOGLE_TOKEN_PATH=secrets/google/token.json
NEST_TOKEN_PATH=secrets/google/nest_token.json

# Runtime tuning
TOOL_LOOP=15
MAX_TOOL_CALLS_PER_TURN=30
MAX_TOOL_CALLS_PER_LOOP=8
MAX_WEB_SEARCHES_PER_LOOP=4
MAX_WEB_FETCHES_PER_LOOP=4
CHAT_DEBOUNCE_DELAY=4.0
EXPERT_ARCHIVE_DIR=data/expert
EXPERT_INDEX_PATH=config/expert_sessions.json
DEBATE_ARCHIVE_DIR=data/debate
DEBATE_INDEX_PATH=config/debate_sessions.json
EXPERT_MAIN_MAX_TOKENS=32768
EXPERT_FAST_MAX_TOKENS=8192
EXPERT_DEFAULT_TARGET_SOURCES=24
EXPERT_MIN_TARGET_SOURCES=12
EXPERT_MAX_SOURCES=80
EXPERT_ALLOW_MIDLOOP_QUESTIONS=false
EXPERT_MAX_AGENDA_QUESTIONS=12
EXPERT_MAX_NEW_QUESTIONS=5
EXPERT_MAX_SUBTASKS_PER_QUESTION=3
EXPERT_MAIN_ENABLE_THINKING=true
EXPERT_MAIN_TEMPERATURE=1.0
EXPERT_MAIN_TOP_P=0.95
EXPERT_MAIN_TOP_K=20
EXPERT_MAIN_MIN_P=0.0
EXPERT_MAIN_PRESENCE_PENALTY=1.5
EXPERT_MAIN_REPETITION_PENALTY=1.0
EXPERT_FAST_ENABLE_THINKING=false
EXPERT_FAST_TEMPERATURE=0.2
EXPERT_FAST_TOP_P=0.9
EXPERT_FAST_TOP_K=40
EXPERT_FAST_MIN_P=0.0
EXPERT_FAST_PRESENCE_PENALTY=0.0
EXPERT_FAST_REPETITION_PENALTY=1.0
MEMORY_THRESHOLD=4000
HEARTBEAT_INTERVAL_SECONDS=3600
HEARTBEAT_SILENCE_THRESHOLD_SECONDS=14400
HEARTBEAT_SILENT_RETRY_SECONDS=3600
HEARTBEAT_PROACTIVE_COOLDOWN_SECONDS=14400
HEARTBEAT_DAILY_PROACTIVE_LIMIT=2
HEARTBEAT_SLEEP_START=21:30
HEARTBEAT_SLEEP_END=03:30
ROUTINE_HISTORY_DEFER_SECONDS=600

# Optional NOAA fallback if no saved home alias exists
# NOAA_LAT=YOUR_LOCATION_LATITUDE
# NOAA_LONG=YOUR_LOCATION_LONGITUDE

# App-managed JSON lives under ./config and is auto-generated on startup.
# You should not need to create or edit those files manually.
